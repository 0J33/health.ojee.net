# health.ojee.net — copy to ~/health-server/.env on the box and fill in.
# This file is read by systemd (EnvironmentFile): plain KEY=value lines, no
# quotes, no `export`. Never commit the real one.

PORT=5020
HOST=127.0.0.1

# The site's own origin. The Google redirect URI is PUBLIC_ORIGIN/auth/google/callback
# and must be listed on the OAuth client in Google Cloud exactly like that.
PUBLIC_ORIGIN=https://health.ojee.net

# The shared ojee.net login: mtg's database (users, sessions) and the cookie
# domain mtg and dnd use. This app touches those two collections only.
MONGODB_URI=mongodb://localhost:27017/mtg
COOKIE_DOMAIN=.ojee.net

# Admins (comma separated usernames). They can close registration.
ADMIN_USERS=ojee

# Encrypts people's OpenCode keys at rest. Long and random; if it changes,
# saved keys can no longer be read and people have to paste them again.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# The Google Cloud OAuth web client (Google Health API enabled).
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# WHOOP (server/whoop.js): the site's app at developer-dashboard.whoop.com. Unset = WHOOP is
# not offered. Its redirect URL there is PUBLIC_ORIGIN/auth/whoop/callback (override with
# WHOOP_REDIRECT_URI), and its webhook URL PUBLIC_ORIGIN/api/whoop/webhook (model version v2).
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=https://health.ojee.net/auth/whoop/callback

# Where each person's data lives (default: ./data next to the code).
# DATA_DIR=/home/disinteg/health-server/data

# AI summaries for everyone, with no key: an `opencode serve` on this box
# (user unit health-opencode.service, loopback only). Leave empty to turn off.
OPENCODE_URL=http://127.0.0.1:4799
# Only OpenCode's free models answer for everyone. 1 = also spend this box's OpenCode Go
# subscription on everyone (its zero-retention models first). People can bring their own
# Go or Zen key in Settings either way.
# AI_SHARED_GO=0

# Optional.
# ZEN_MODELS=space-bunny-free,longcat-2.5-preview-free,step-5-preview-free,big-pickle,mimo-v2.6-flash-free
# VAPID_SUBJECT=mailto:you@example.com
# The Android app's notifications (server/fcm.js): the path of a Firebase service-account key
# (Firebase console, Project settings, Service accounts, Generate new private key). Unset: the
# app shows "not set up yet" and browsers keep Web Push as before.
# FCM_SERVICE_ACCOUNT=/home/you/.config/health-server/fcm-service-account.json
# DEFAULT_TZ=Africa/Cairo
# SYNC_MINUTES=20
# SYNC_CONCURRENCY=3
# WORLD_CACHE=40
